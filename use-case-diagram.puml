@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title SkillKita - Use Case Diagram (Web + Mobile)

actor Visitor
actor Employer
actor Admin
actor System
actor "OCR Service" as OCR
actor "Recommendation Engine" as Rec

rectangle "SkillKita Platform" {

  package "Module 1: User & Communication" {
    usecase "UC-USR-01\nSign Up / Create Account" as UC_USR_01
    usecase "UC-USR-02\nLog In" as UC_USR_02
    usecase "UC-USR-03\nLog Out" as UC_USR_03
    usecase "UC-USR-04\nReset Password" as UC_USR_04
    usecase "UC-USR-05\nManage Users" as UC_USR_05
    usecase "UC-USR-06\nManage Roles & Permissions" as UC_USR_06
    usecase "UC-USR-07\nManage Profile" as UC_USR_07

    usecase "UC-COM-01\nSend Message" as UC_COM_01
    usecase "UC-COM-02\nReceive Message" as UC_COM_02
    usecase "UC-COM-03\nShare Files in Message" as UC_COM_03
  }

  package "Module 2: Courses & Private Documents" {
    usecase "UC-CRS-01\nView Courses" as UC_CRS_01
    usecase "UC-CRS-02\nManage Courses" as UC_CRS_02

    usecase "UC-DOC-01\nRequest Access to Private Documents" as UC_DOC_01
    usecase "UC-DOC-02\nApprove/Reject Access Request" as UC_DOC_02
    usecase "UC-DOC-03\nView Access Request Status" as UC_DOC_03
    usecase "UC-DOC-04\nManage Document Permissions" as UC_DOC_04
  }

  package "Module 3: Quotations" {
    usecase "UC-QUO-01\nCreate Quotation" as UC_QUO_01
    usecase "UC-QUO-02\nView Quotation" as UC_QUO_02
    usecase "UC-QUO-03\nUpdate/Cancel Quotation" as UC_QUO_03
    usecase "UC-QUO-04\nDownload Quotation" as UC_QUO_04
    usecase "UC-QUO-05\nSend Quotation" as UC_QUO_05
  }

  package "Module 4: AI, Status & Notifications" {
    usecase "UC-AI-01\nExtract Data from Image (OCR)" as UC_AI_01
    usecase "UC-AI-02\nValidate/Correct OCR Result" as UC_AI_02
    usecase "UC-AI-03\nGet Personalized Course Suggestions" as UC_AI_03

    usecase "UC-STS-01\nView Request/Process Status" as UC_STS_01
    usecase "UC-NOT-01\nReceive Real-Time Notification" as UC_NOT_01
    usecase "UC-NOT-02\nConfigure Notification Preferences" as UC_NOT_02
    usecase "UC-SYS-01\nTrigger Status Update Notification" as UC_SYS_01
  }
}

' Actor to use case mapping
Visitor --> UC_USR_01
Visitor --> UC_CRS_01
Visitor --> UC_AI_03

Employer --> UC_USR_02
Employer --> UC_USR_03
Employer --> UC_USR_04
Employer --> UC_USR_07
Employer --> UC_COM_01 
Employer --> UC_COM_02
Employer --> UC_COM_03
Employer --> UC_CRS_01
Employer --> UC_DOC_01
Employer --> UC_DOC_03
Employer --> UC_QUO_01
Employer --> UC_QUO_02
Employer --> UC_QUO_04
Employer --> UC_AI_01
Employer --> UC_AI_02
Employer --> UC_STS_01
Employer --> UC_NOT_01
Employer --> UC_NOT_02

Admin --> UC_USR_02
Admin --> UC_USR_03
Admin --> UC_USR_04
Admin --> UC_USR_05
Admin --> UC_USR_06
Admin --> UC_USR_07
Admin --> UC_COM_01
Admin --> UC_COM_02
Admin --> UC_COM_03
Admin --> UC_CRS_01
Admin --> UC_CRS_02
Admin --> UC_DOC_02
Admin --> UC_DOC_04
Admin --> UC_QUO_01
Admin --> UC_QUO_02
Admin --> UC_QUO_03
Admin --> UC_QUO_04
Admin --> UC_QUO_05
Admin --> UC_AI_01
Admin --> UC_AI_02
Admin --> UC_STS_01
Admin --> UC_NOT_01
Admin --> UC_NOT_02

System --> UC_SYS_01
System --> UC_NOT_01

OCR --> UC_AI_01
Rec --> UC_AI_03

' include / extend examples
UC_QUO_01 .> UC_USR_02 : <<include>>
UC_DOC_01 .> UC_USR_02 : <<include>>
UC_DOC_01 .> UC_STS_01 : <<include>>
UC_AI_01 .> UC_AI_02 : <<include>>

UC_NOT_01 ..> UC_DOC_02 : <<extend>>
UC_NOT_01 ..> UC_QUO_03 : <<extend>>
UC_NOT_01 ..> UC_COM_01 : <<extend>>
UC_SYS_01 .> UC_NOT_01 : <<include>>

@enduml
