# Used by Vite dev proxy target and production builds. In `npm run dev`, the app calls /supabase-api on localhost instead.
# NOTE: .env.local overrides this file if present — keep both URLs in sync.
# Vercel: Project → Settings → Environment Variables — add the same names for Production (and Preview if needed).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Legacy anon JWT (eyJ...) or publishable key (sb_publishable_...) from Project Settings → API Keys
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_KEY_HERE

# Server-only (Vercel / local dev API). Get a free key at https://aistudio.google.com/apikey
# Do NOT prefix with VITE_ — this must not be exposed to the browser bundle.
GEMINI_API_KEY=

